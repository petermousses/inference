diff --git a/src/models/deepseek41.cpp b/src/models/deepseek41.cpp
new file mode 100644
index 0000000..25c72d3
--- /dev/null
+++ b/src/models/deepseek41.cpp
@@ -0,0 +1,1255 @@
+#include "llama-hparams.h"
+#include "models.h"
+
+#include "llama-kv-cache-dsv4.h"
+
+#include <algorithm>
+#include <array>
+#include <cinttypes>
+#include <cmath>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+// DeepSeek-V4.1.
+//
+// Shares almost everything with DeepSeek-V4: the hyper-connection stream, the MoE, the latent
+// attention and the compressed KV cache. Three things differ.
+//
+// 1. The hyper-connection coefficients lag by one sublayer. A sublayer computes the mix that the
+//    NEXT one consumes, so attention uses what the previous layer's FFN produced. V4 computes and
+//    consumes in the same sublayer.
+// 2. There is no learned hyper-connection head. Nothing is left to collapse the copies with in V4,
+//    which is why it needs one; here the last layer's FFN mix is still unused and does the job.
+//    These two facts explain each other, and the file ships no output_hc_* tensors.
+// 3. The engram tables: n-gram keyed lookups added into the stream at a few layers.
+//
+// The sparse attention also differs. V4 compresses KV on every layer at one of two fixed ratios;
+// V4.1 compresses on a few source layers and the layers after each source read the same rows, and
+// it derives index keys from that shared latent rather than from a second compressor. See
+// build_attention_v41().
+//
+// mean over the hyper-connection copies; deepseek4.cpp keeps its own copy of this
+static ggml_tensor * dsv41_hc_mean(ggml_context * ctx, ggml_tensor * x) {
+    const int64_t hc = x->ne[1];
+
+    ggml_tensor * acc = ggml_view_2d(ctx, x, x->ne[0], x->ne[2], x->nb[2], 0);
+    for (int64_t s = 1; s < hc; ++s) {
+        acc = ggml_add(ctx, acc, ggml_view_2d(ctx, x, x->ne[0], x->ne[2], x->nb[2], s*x->nb[1]));
+    }
+    return ggml_scale(ctx, acc, 1.0f/hc);
+}
+
+int llama_model_deepseek41::engram_index(int il) const {
+    for (uint32_t e = 0; e < engram_n_layer; ++e) {
+        if (hparams.engram_layer_ids[e] == (uint32_t) il) {
+            return (int) e;
+        }
+    }
+    return -1;
+}
+
+static bool dsv41_is_prime(uint64_t n) {
+    if (n < 2) {
+        return false;
+    }
+    if (n % 2 == 0) {
+        return n == 2;
+    }
+    for (uint64_t d = 3; d <= n / d; d += 2) {
+        if (n % d == 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static uint64_t dsv41_next_prime(uint64_t start, const std::unordered_set<uint64_t> & used) {
+    uint64_t candidate = start + 1;
+    while (!dsv41_is_prime(candidate) || used.count(candidate) != 0) {
+        ++candidate;
+    }
+    return candidate;
+}
+
+void llama_model_deepseek41::load_arch_hparams(llama_model_loader & ml) {
+    llama_model_deepseek4::load_arch_hparams(ml);
+
+    ml.get_key(LLM_KV_ATTENTION_INDEXER_CANDIDATE_SOURCE_LAYER, hparams.dsv41_candidate_source_layer, false);
+    ml.get_key(LLM_KV_ATTENTION_INDEXER_CANDIDATE_TOP_K_BLOCKS, hparams.dsv41_candidate_top_k_blocks, false);
+    ml.get_key(LLM_KV_ATTENTION_INDEXER_CANDIDATE_BLOCK_SIZE,   hparams.dsv41_candidate_block_size, false);
+
+    if (hparams.dsv41_candidate_source_layer < -1 ||
+        (hparams.dsv41_candidate_source_layer >= 0 &&
+         static_cast<uint32_t>(hparams.dsv41_candidate_source_layer) >= hparams.n_layer())) {
+        throw std::runtime_error("DeepSeek-V4.1 candidate source layer must be -1 or a valid layer");
+    }
+
+    if (hparams.dsv41_candidate_source_layer == -1) {
+        if (hparams.dsv41_candidate_top_k_blocks != 0 || hparams.dsv41_candidate_block_size != 0) {
+            throw std::runtime_error("DeepSeek-V4.1 candidate block sizes must be zero when candidate attention is disabled");
+        }
+    } else if (hparams.dsv41_candidate_top_k_blocks == 0 || hparams.dsv41_candidate_block_size == 0) {
+        throw std::runtime_error("DeepSeek-V4.1 candidate attention needs positive block count and block size");
+    } else if (hparams.dsv41_candidate_block_size > 1024) {
+        throw std::runtime_error("DeepSeek-V4.1 candidate block size exceeds the supported maximum of 1024");
+    }
+
+    const auto * combined_table = ml.get_weight("per_layer_token_embd.weight");
+    std::vector<uint32_t> gate_layers;
+    for (uint32_t il = 0; il < hparams.n_layer(); ++il) {
+        const std::string gate_name = format("blk.%u.engram_gate.weight", il);
+        if (ml.get_weight(gate_name.c_str()) != nullptr) {
+            gate_layers.push_back(il);
+        }
+    }
+    engram_combined_table = combined_table != nullptr || !gate_layers.empty();
+    if (engram_combined_table && (combined_table == nullptr || gate_layers.empty())) {
+        throw std::runtime_error("Unsloth Engram format must provide both per_layer_token_embd.weight and per-layer engram_gate weights");
+    }
+
+    uint32_t metadata_engram_layers = 0;
+    const bool has_layer_ids = ml.get_arr_n(LLM_KV_ENGRAM_LAYER_IDS, metadata_engram_layers, false);
+    if (engram_combined_table) {
+        if (gate_layers.size() != 2 || gate_layers[0] != 1 || gate_layers[1] != 14) {
+            throw std::runtime_error("Unsloth Engram fallback currently requires exactly layers 1 and 14");
+        }
+        engram_n_layer = (uint32_t) gate_layers.size();
+        for (uint32_t e = 0; e < engram_n_layer; ++e) {
+            hparams.engram_layer_ids[e] = gate_layers[e];
+        }
+        if (has_layer_ids) {
+            if (metadata_engram_layers != engram_n_layer) {
+                throw std::runtime_error("Unsloth Engram layer metadata disagrees with gate tensors");
+            }
+            std::array<uint32_t, LLAMA_MAX_LAYERS> metadata_layer_ids = {};
+            ml.get_arr(LLM_KV_ENGRAM_LAYER_IDS, metadata_layer_ids);
+            for (uint32_t e = 0; e < engram_n_layer; ++e) {
+                if (metadata_layer_ids[e] != hparams.engram_layer_ids[e]) {
+                    throw std::runtime_error("Unsloth Engram layer metadata disagrees with gate tensors");
+                }
+            }
+        }
+
+        constexpr uint32_t expected_vocab_size = 16000000;
+        constexpr uint32_t expected_compressed_vocab_size = 99092;
+        constexpr uint32_t expected_pad_token_id = 2;
+        uint32_t vocab_size = 0;
+        uint32_t compressed_vocab_size = 0;
+        uint32_t raw_pad_token_id = 0;
+        ml.get_key(LLM_KV_ENGRAM_VOCAB_SIZE, vocab_size);
+        ml.get_key(LLM_KV_ENGRAM_COMPRESSED_VOCAB_SIZE, compressed_vocab_size);
+        ml.get_key(LLM_KV_ENGRAM_PAD_TOKEN_ID, raw_pad_token_id);
+        uint32_t optional_value = 0;
+        if ((ml.get_key(LLM_KV_ENGRAM_HEAD_COUNT, optional_value, false) && optional_value != 8) ||
+            (ml.get_key(LLM_KV_ENGRAM_KEY_LENGTH, optional_value, false) && optional_value != 256) ||
+            (ml.get_key(LLM_KV_ENGRAM_MAX_NGRAM_SIZE, optional_value, false) && optional_value != 4)) {
+            throw std::runtime_error("Unsloth Engram shape metadata disagrees with the supported DeepSeek-V4.1-Flash-1017 layout");
+        }
+        if (vocab_size != expected_vocab_size || compressed_vocab_size != expected_compressed_vocab_size ||
+            raw_pad_token_id != expected_pad_token_id) {
+            throw std::runtime_error("Unsloth Engram metadata does not match the supported DeepSeek-V4.1-Flash-1017 layout");
+        }
+
+        hparams.engram_n_head = 8;
+        hparams.engram_key_length = 256;
+        hparams.engram_max_ngram_size = 4;
+        // NumPy default_rng(10007 * layer_id), pinned to the released 1017 tokenizer layout.
+        const std::array<std::array<uint64_t, 4>, 2> multipliers = {{
+            {{76632096046245ULL, 4839876093313ULL, 35959672319349ULL, 73987337458391ULL}},
+            {{67716810739261ULL, 51510806800915ULL, 30921347202721ULL, 82619226485591ULL}},
+        }};
+        engram_multipliers.clear();
+        for (const auto & per_layer : multipliers) {
