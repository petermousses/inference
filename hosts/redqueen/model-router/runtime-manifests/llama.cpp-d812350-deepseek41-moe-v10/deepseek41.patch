+        }
+
+        engram_primes.clear();
+        engram_offsets.clear();
+        engram_table_offsets.clear();
+        engram_table_rows.clear();
+        std::unordered_set<uint64_t> used_primes;
+        int64_t combined_offset = 0;
+        for (uint32_t e = 0; e < engram_n_layer; ++e) {
+            engram_table_offsets.push_back(combined_offset);
+            uint64_t layer_rows = 0;
+            for (uint32_t ngram = 0; ngram < hparams.engram_max_ngram_size - 1; ++ngram) {
