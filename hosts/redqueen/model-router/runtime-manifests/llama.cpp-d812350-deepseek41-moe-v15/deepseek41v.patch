+// DeepSeek-V4.1 image resize and token-budget policy, matching inference/image_processor.py.
+static int dsv41_llm_grid_h(int height, int patch_size, int downsample_ratio) {
+    return (height / patch_size + downsample_ratio - 1) / downsample_ratio;
+}
+
+static int dsv41_llm_grid_w(int width, int patch_size, int downsample_ratio) {
+    return (width / patch_size + downsample_ratio - 1) / downsample_ratio;
+}
+
+static clip_image_size dsv41_solve_resize_ratio(int height, int width, int patch_size,
+                                                int downsample_ratio, int max_n_token) {
+    const double ratio = (double) height / width;
+    const double max_w_float = std::sqrt((max_n_token - 2) / ratio + 0.25) - 0.5;
+    const double max_h_float = max_w_float * ratio;
+    const int cell = patch_size * downsample_ratio;
+
+    if (max_w_float < 1.0) {
+        return { cell, ((max_n_token - 2) / 2) * cell };
+    }
+    if (max_h_float < 1.0) {
+        return { (max_n_token - 3) * cell, cell };
+    }
+
+    const int max_w = (int) std::floor(max_w_float);
+    const int max_h = (int) std::floor(max_h_float);
+    const double beta = std::min((double) max_w * cell / width, (double) max_h * cell / height);
+    const int best_height = (int) std::floor(height * beta / patch_size) * patch_size;
+    const int best_width = (int) std::floor(width * beta / patch_size) * patch_size;
+    return { best_width, best_height };
+}
+
+mtmd_image_preproc_out mtmd_image_preprocessor_deepseek41v::preprocess(const clip_image_u8 & img) const {
+    mtmd_image_preproc_out out;
+    const int patch_size = hparams.patch_size;
+    const int downsample_ratio = hparams.n_merge;
+    const int max_n_token = hparams.deepseek_vision_max_n_token;
+
+    const clip_image_size orig = img.get_size();
+    int width = orig.width;
+    int height = orig.height;
+    const int max_wh_ratio = hparams.deepseek_vision_max_wh_ratio;
+    if (max_wh_ratio > 0 && width > height * max_wh_ratio) {
+        width = height * max_wh_ratio;
+    }
+    const int64_t n_pixels = (int64_t) width * height;
+    if (n_pixels > 0 && n_pixels < hparams.image_min_pixels) {
+        const double up = std::sqrt((double) hparams.image_min_pixels / n_pixels);
+        width = (int) (width * up);
+        height = (int) (height * up);
+    }
+
+    int best_width = CLIP_ALIGN(width, patch_size);
+    int best_height = CLIP_ALIGN(height, patch_size);
+    const int grid_h = dsv41_llm_grid_h(best_height, patch_size, downsample_ratio);
+    const int grid_w = dsv41_llm_grid_w(best_width, patch_size, downsample_ratio);
+    if (dsv41_get_num_image_tokens(grid_h, grid_w) > max_n_token) {
+        const clip_image_size safe = dsv41_solve_resize_ratio(height, width, patch_size, downsample_ratio, max_n_token);
+        best_width = safe.width;
+        best_height = safe.height;
+    }
+
+    const int final_h = dsv41_llm_grid_h(best_height, patch_size, downsample_ratio);
+    const int final_w = dsv41_llm_grid_w(best_width, patch_size, downsample_ratio);
+    GGML_ASSERT(dsv41_get_num_image_tokens(final_h, final_w) <= max_n_token);
+
+    clip_image_u8 resized;
+    if (max_wh_ratio > 0 && orig.width >= max_wh_ratio * orig.height) {
+        img_tool::resize(img, resized, { best_width, best_height }, hparams.image_resize_algo, PAD_NONE);
+    } else {
+        img_tool::resize(img, resized, { best_width, best_height }, hparams.image_resize_algo,
+                         PAD_NEAREST, hparams.image_pad_color);
+    }
+    out.append(hparams, resized);
+    return out;
+}
