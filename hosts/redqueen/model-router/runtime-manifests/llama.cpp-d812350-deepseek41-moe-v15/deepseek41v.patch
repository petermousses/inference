+// DeepSeek-V4.1 places image rows in reading order without V4's compression padding.
+static inline int dsv41_get_num_image_tokens(int n_llm_h, int n_llm_w) {
+    return n_llm_h * (n_llm_w + 1) + 2;
+}
+
+static inline std::vector<int32_t> dsv41_get_image_layout_idx(int n_llm_w, int n_llm_h) {
+    const int n_grid = n_llm_w * n_llm_h;
+    const int idx_start = n_grid;
+    const int idx_end = n_grid + 1;
+    const int idx_newline = n_grid + 2;
+
+    std::vector<int32_t> idx;
+    idx.reserve(dsv41_get_num_image_tokens(n_llm_h, n_llm_w));
+    idx.push_back(idx_start);
+    for (int row = 0; row < n_llm_h; ++row) {
+        for (int col = 0; col < n_llm_w; ++col) {
+            idx.push_back(row * n_llm_w + col);
+        }
+        idx.push_back(idx_newline);
+    }
+    idx.push_back(idx_end);
+    return idx;
+}
