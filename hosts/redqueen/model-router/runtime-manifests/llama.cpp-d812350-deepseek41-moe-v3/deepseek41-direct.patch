new file mode 100644
index 0000000..9988188
--- /dev/null
+++ b/src/llama-lazy-reader.h
@@ -0,0 +1,155 @@
+#pragma once
+
+// Read selected rows of a lazy tensor with explicit pread() calls. The model
+// graph knows the row ids before execution, so no giant mmap page range needs
+// to be faulted into GPU-visible memory.
+
+#include "ggml.h"
+#include "llama-impl.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <exception>
+#include <limits>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#ifndef _WIN32
+#include <fcntl.h>
+#include <unistd.h>
+
+struct llama_lazy_reader {
+    llama_lazy_reader(int fd, size_t base, size_t row_size, int64_t n_rows,
+                      int n_threads, enum ggml_type type, int64_t head_dim)
+        : fd(fd), base(base), row_size(row_size), n_rows(n_rows),
+          n_threads(std::max(1, n_threads)), head_dim(head_dim),
+          to_float(type == GGML_TYPE_F32 ? nullptr : ggml_get_type_traits(type)->to_float) {
+        if (fd < 0 || row_size == 0 || n_rows <= 0 || head_dim <= 0 ||
+            (type != GGML_TYPE_F32 && to_float == nullptr)) {
+            throw std::runtime_error("invalid lazy direct reader tensor layout");
+        }
+    }
+
+    llama_lazy_reader(const llama_lazy_reader &) = delete;
+    llama_lazy_reader & operator=(const llama_lazy_reader &) = delete;
+
+    ~llama_lazy_reader() {
+        if (fd >= 0) {
+            ::close(fd);
+        }
+    }
+
+    const int      fd;
+    const size_t   base;
+    const size_t   row_size;
+    const int64_t  n_rows;
+    const int      n_threads;
+    const int64_t  head_dim;
+    ggml_to_float_t to_float;
+
+    // Output is row-major F32, matching ggml_get_rows. row_offset selects a
+    // contiguous logical view inside the combined Unsloth Engram tensor.
+    void gather(const int32_t * rows, int64_t n, int64_t row_offset, float * dst) const {
+        if (n < 0 || row_offset < 0 || row_offset > n_rows || (n > 0 && (!rows || !dst))) {
+            throw std::runtime_error("invalid lazy direct gather request");
+        }
+        if (n == 0) {
+            return;
+        }
+
+        std::vector<std::pair<int64_t, int64_t>> pairs;
+        pairs.reserve((size_t) n);
+        for (int64_t i = 0; i < n; ++i) {
+            if (rows[i] < 0 || (int64_t) rows[i] >= n_rows - row_offset) {
+                throw std::runtime_error(format("lazy direct row index %d with offset %lld is outside %lld rows",
+                        rows[i], (long long) row_offset, (long long) n_rows));
+            }
+            pairs.emplace_back((int64_t) rows[i] + row_offset, i);
+        }
+        std::sort(pairs.begin(), pairs.end());
+
+        const int n_workers = (int) std::min<int64_t>(n_threads, std::max<int64_t>(1, n / 32));
+        auto run_chunk = [&](int worker, std::exception_ptr & error) {
+            try {
+                run_range(pairs, n * worker / n_workers, n * (worker + 1) / n_workers, dst);
+            } catch (...) {
+                error = std::current_exception();
+            }
+        };
+
+        std::vector<std::exception_ptr> errors(n_workers);
+        std::vector<std::thread> workers;
+        try {
+            for (int worker = 1; worker < n_workers; ++worker) {
+                workers.emplace_back([&run_chunk, &errors, worker] { run_chunk(worker, errors[worker]); });
+            }
+        } catch (...) {
+            for (auto & worker : workers) {
+                worker.join();
+            }
+            throw;
+        }
+        run_chunk(0, errors[0]);
+        for (auto & worker : workers) {
+            worker.join();
+        }
+        for (const auto & error : errors) {
+            if (error) {
+                std::rethrow_exception(error);
+            }
+        }
+    }
+
+private:
+    void run_range(const std::vector<std::pair<int64_t, int64_t>> & pairs,
+                   int64_t begin, int64_t end, float * dst) const {
+        std::vector<uint8_t> bounce(row_size);
+        for (int64_t i = begin; i < end; ) {
+            int64_t last = i;
+            while (last + 1 < end && pairs[last + 1].first == pairs[i].first) {
+                ++last;
+            }
+
+            const uint64_t row = (uint64_t) pairs[i].first;
+            if (row > (std::numeric_limits<size_t>::max() - base) / row_size) {
+                throw std::runtime_error("lazy direct file offset overflows size_t");
+            }
+            const size_t offset = base + (size_t) row * row_size;
+            size_t done = 0;
+            while (done < row_size) {
+                const ssize_t n_read = ::pread(fd, bounce.data() + done, row_size - done, (off_t) (offset + done));
+                if (n_read < 0 && errno == EINTR) {
+                    continue;
+                }
+                if (n_read <= 0) {
+                    throw std::runtime_error(format("lazy direct read of %zu bytes at file offset %zu failed: %s",
+                            row_size, offset, n_read == 0 ? "unexpected EOF" : strerror(errno)));
+                }
+                done += (size_t) n_read;
+            }
+
+            float * first = dst + (size_t) pairs[i].second * head_dim;
+            if (to_float) {
+                to_float(bounce.data(), first, head_dim);
+            } else {
+                memcpy(first, bounce.data(), (size_t) head_dim * sizeof(float));
+            }
+            for (int64_t slot = i + 1; slot <= last; ++slot) {
+                memcpy(dst + (size_t) pairs[slot].second * head_dim, first, (size_t) head_dim * sizeof(float));
+            }
+            i = last + 1;
+        }
+    }
+};
+#else
+struct llama_lazy_reader {
+    const int64_t head_dim = 0;
+    void gather(const int32_t *, int64_t, int64_t, float *) const {
+        throw std::runtime_error("--lazy-mode on-direct is only supported on POSIX systems");
+    }
+};
+#endif
