+const llama_lazy_reader * llama_model_base::load_lazy_reader(llama_model_loader & ml, const char * tensor_name, const ggml_tensor * tensor) {
+    if (ml.lazy.mode != LLAMA_LAZY_MODE_DIRECT) {
+        return nullptr;
+    }
+    if (!tensor) {
+        throw std::runtime_error(format("lazy direct tensor %s was not created", tensor_name));
+    }
+    if (const auto it = lazy_readers.find(tensor_name); it != lazy_readers.end()) {
+        return it->second.get();
+    }
+
+    const auto * weight = ml.get_weight(tensor_name);
+    if (!weight || weight->idx >= ml.files.size()) {
+        throw std::runtime_error(format("lazy direct tensor %s has no file-backed weight", tensor_name));
+    }
+    const std::string & path = ml.files[weight->idx]->name();
+    if (path.empty() || path == "(file*)") {
+        throw std::runtime_error(format("lazy direct tensor %s requires a reopenable model file path", tensor_name));
+    }
+
+#ifndef _WIN32
+    const int fd = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        throw std::runtime_error(format("could not open %s for lazy direct reads: %s", path.c_str(), strerror(errno)));
+    }
+    struct fd_guard {
+        int fd;
+        ~fd_guard() { if (fd >= 0) ::close(fd); }
+    } guard{fd};
+#ifdef __linux__
+    (void) ::posix_fadvise(fd, 0, 0, POSIX_FADV_RANDOM);
+#endif
+    const int n_threads = std::min(8, std::max(1, (int) std::thread::hardware_concurrency()));
+    auto reader = std::make_unique<llama_lazy_reader>(fd, weight->offs,
+            ggml_row_size(tensor->type, tensor->ne[0]), tensor->ne[1], n_threads,
+            tensor->type, tensor->ne[0]);
+    guard.fd = -1;
+    LLAMA_LOG_INFO("%s: direct reads enabled for %s: %" PRId64 " rows of %zu bytes at file offset %zu, %d threads\n",
+            __func__, tensor_name, reader->n_rows, reader->row_size, weight->offs, n_threads);
+    lazy_readers[tensor_name] = std::move(reader);
+    return lazy_readers.at(tensor_name).get();
+#else
+    throw std::runtime_error("--lazy-mode on-direct requires POSIX pread support");
+#endif
+}
