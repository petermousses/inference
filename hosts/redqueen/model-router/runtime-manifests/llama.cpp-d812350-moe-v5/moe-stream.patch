diff --git a/tests/test-moe-stream.cpp b/tests/test-moe-stream.cpp
new file mode 100644
index 0000000..e8970f8
--- /dev/null
+++ b/tests/test-moe-stream.cpp
@@ -0,0 +1,130 @@
+#include "llama-moe-stream.h"
+#include "llama.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "arg.h"
+
+#include <cstdio>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) {
+        throw std::runtime_error(message);
+    }
+}
+
+template<typename F> static void rejects(F operation, const char * message) {
+    bool rejected = false;
+    try {
+        operation();
+    } catch (const std::runtime_error &) {
+        rejected = true;
+    }
+    require(rejected, message);
+}
+
+static void make_cache(llama_moe_stream & stream, const ggml_tensor * meta) {
+    stream.create_cache_tensor(0, ggml_backend_cpu_buffer_type(), meta, 0, 0, 2);
+}
+
+static bool parse_cache_arg(const std::string & value, common_params & params) {
+    std::vector<std::string> args = { "test-moe-stream", "--model", "unused.gguf", "--moe-stream-cache", value };
+    std::vector<char *> argv;
+    argv.reserve(args.size());
+    for (auto & arg : args) {
+        argv.push_back(arg.data());
+    }
+    return common_params_parse((int) argv.size(), argv.data(), params, LLAMA_EXAMPLE_COMMON);
+}
+
+int main() {
+    try {
+        {
+            common_params params;
+            require(parse_cache_arg("4g", params) && params.moe_stream_budget == 4ull*1024*1024*1024,
+                    "GiB expert cache argument did not parse");
+            common_params slots;
+            require(parse_cache_arg("64s", slots) && slots.moe_stream_slots == 64,
+                    "slot expert cache argument did not parse");
+            for (const char * invalid : { "-4g", "+4g", "0g", "18446744073709551615g", "18446744073709551616g" }) {
+                common_params rejected_params;
+                require(!parse_cache_arg(invalid, rejected_params), "invalid cache budget syntax was accepted");
+            }
+        }
+
+        ggml_context_ptr ctx(ggml_init({64*1024, nullptr, false}));
+        auto * meta = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_F32, 32, 8, 4);
+        ggml_set_name(meta, "blk.0.ffn_down_exps.weight");
+
+        llama_moe_stream plan(1, 2, 1, true);
+        make_cache(plan, meta);
+        plan.alloc_bufs(true);
+        llama_moe_stream_info planned{};
+        plan.get_info(planned);
+        require(planned.cache_bytes >= 2*1024, "planner omitted expert cache");
+        require(planned.host_overhead_bytes >= 4*1024*1024 + 1024 + 8192, "planner omitted I/O and control memory");
+        require(!planned.direct_io_verified, "planning falsely verified direct I/O");
+        require(plan.memory_breakdown().at(ggml_backend_cpu_buffer_type()) == planned.cache_bytes + planned.host_overhead_bytes,
+                "combined stream memory report omitted a component");
+
+        llama_moe_stream insufficient_topk(1, 2, 1, true);
+        rejects([&] {
+            insufficient_topk.create_cache_tensor(0, ggml_backend_cpu_buffer_type(), meta, 0, 0, 3);
+        }, "cache with fewer slots than this layer's router top-k was accepted");
+        require(insufficient_topk.ctxs.empty(), "top-k failure created cache backing metadata");
+
+        llama_moe_stream too_small(1, 2, 1, true, planned.cache_bytes - 1);
+        make_cache(too_small, meta);
+        rejects([&] { too_small.alloc_bufs(false); }, "cache exceeded hard byte budget");
+        require(too_small.bufs.empty(), "insufficient budget allocated cache backing");
+
+        llama_moe_stream live(1, 2, 1, true, planned.cache_bytes);
+        make_cache(live, meta);
+        live.alloc_bufs(false);
+        llama_moe_stream_info actual{};
+        live.get_info(actual);
+        require(actual.cache_bytes == planned.cache_bytes, "planned/live cache bytes differ");
+        require(actual.host_overhead_bytes == planned.host_overhead_bytes, "planned/live staging bytes differ");
+
+        {
+            llama_moe_stream_context_lease first(live);
+            rejects([&] { llama_moe_stream_context_lease second(live); }, "second model context was accepted");
+        }
+        llama_moe_stream_context_lease reopened(live);
+
+        auto * layer = live.layer(0);
+        layer->slot_expert = {2, 1};
+        layer->slot_state = {LLAMA_MOE_STREAM_SLOT_RESIDENT, LLAMA_MOE_STREAM_SLOT_RESIDENT};
+        layer->expert_slot = {{2, 0}, {1, 1}};
+        live.workers_started = true; // this remap fixture contains hits only and needs no I/O worker
+        auto * ids = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, 2);
+        auto * out = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, 2);
+        ((int32_t *) ids->data)[0] = 1;
+        ((int32_t *) ids->data)[1] = 2;
+        llama_moe_stream_remap(out, ids, 0, 1, layer);
+        require(((int32_t *) out->data)[0] == 1 && ((int32_t *) out->data)[1] == 0, "remap changed routed expert order");
+        live.get_info(actual);
+        require(actual.hits == 2 && actual.misses == 0 && actual.pending_reads == 0, "cache inspection counters are incorrect");
+
+        rejects([&] { live.open_files({}, {}); }, "empty model shard set was accepted");
+        rejects([&] { live.open_files({""}, {}); }, "file-descriptor model was accepted");
+        llama_moe_stream buffered(1, 2, 1, false);
+        rejects([&] { buffered.open_files({"unused.gguf"}, {}); }, "buffered expert fallback was accepted");
+#if defined(__linux__)
+        llama_moe_stream non_regular(1, 2, 1, true);
+        make_cache(non_regular, meta);
+        non_regular.alloc_bufs(false);
+        llama_files non_regular_source;
+        non_regular_source.emplace_back(new llama_file("/dev/null", "rb"));
+        rejects([&] { non_regular.open_files({"/dev/null"}, non_regular_source); }, "non-regular expert shard was accepted");
+        require(!non_regular.direct_io_verified, "rejected shard set was reported verified");
+#endif
+        std::puts("expert stream allocation, admission, remap and direct-I/O negative gates passed");
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    return 0;
+}
