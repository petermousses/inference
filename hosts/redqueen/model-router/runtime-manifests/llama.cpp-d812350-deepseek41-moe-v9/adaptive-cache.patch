+bool llama_context::resize_moe_stream_cache(uint64_t capacity_bytes, llama_moe_stream_info * info) {
+    std::lock_guard<std::recursive_mutex> lock(moe_stream_resize_mutex);
+    auto * stream = model.moe_stream();
+    if (!stream || !info) {
+        return false;
