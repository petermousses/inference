+size_t llama_moe_stream::planned_capacity_bytes(uint32_t slots) {
+    struct tensor_state {
+        ggml_tensor * tensor;
+        int64_t ne2;
+        size_t nb3;
+        void * data;
+    };
+    std::vector<tensor_state> old_states;
+    for (const auto & layer : layers) {
+        if (!layer) {
+            continue;
+        }
+        for (const auto & weight : layer->weights) {
+            ggml_tensor * tensor = weight.cache;
+            old_states.push_back({tensor, tensor->ne[2], tensor->nb[3], tensor->data});
+        }
+    }
+
+    for (const auto & old : old_states) {
+        ggml_tensor * tensor = old.tensor;
+        tensor->ne[2] = slots;
+        tensor->nb[3] = tensor->nb[2] * slots;
+        // GGML's size planner counts only tensors whose backing pointer is null.
+        tensor->data = nullptr;
+    }
+
+    const auto restore = [&]() {
+        for (const auto & old : old_states) {
+            old.tensor->ne[2] = old.ne2;
+            old.tensor->nb[3] = old.nb3;
+            old.tensor->data = old.data;
+        }
+    };
+    size_t total = 0;
+    try {
+        for (const auto & [buft, ctx] : ctxs) {
+            const size_t size = ggml_backend_alloc_ctx_tensors_from_buft_size(ctx.get(), buft);
+            if (size > SIZE_MAX - total) {
+                throw std::runtime_error("expert cache allocation size overflows");
+            }
+            total += size;
+        }
+    } catch (...) {
+        restore();
+        throw;
+    }
+    restore();
+    return total;
+}
+
+void llama_moe_stream::configure_capacity_bounds() {
+    if (capacity_bounds_ready) {
+        return;
+    }
+    if (min_slots == 0) {
+        throw std::runtime_error("expert cache has no startup slot floor");
+    }
+    uint64_t bytes_per_slot = 0;
+    uint32_t slot_limit = 65535;
+    for (const auto & layer : layers) {
+        if (!layer) {
+            continue;
+        }
+        slot_limit = std::min(slot_limit, layer->n_expert - 1);
+        for (const auto & weight : layer->weights) {
+            if (weight.nb_expert > UINT64_MAX - bytes_per_slot) {
+                throw std::runtime_error("expert cache byte estimate overflows");
+            }
+            bytes_per_slot += weight.nb_expert;
+        }
+    }
+    if (bytes_per_slot == 0 || slot_limit < min_slots) {
+        throw std::runtime_error("expert cache bounds do not cover the startup slot floor");
+    }
+    max_slots = min_slots;
+    if (max_cache_budget > 0) {
+        max_slots = std::min<uint64_t>(slot_limit, max_cache_budget / bytes_per_slot);
+        if (max_slots < min_slots) {
+            throw std::runtime_error("maximum expert cache budget is below its startup allocation");
+        }
+        while (max_slots > min_slots && planned_capacity_bytes(max_slots) > max_cache_budget) {
+            max_slots--;
+        }
+        if (planned_capacity_bytes(max_slots) > max_cache_budget) {
+            throw std::runtime_error("maximum expert cache budget cannot hold the startup allocation");
+        }
+    }
+    min_capacity_bytes = planned_capacity_bytes(min_slots);
+    max_capacity_bytes = planned_capacity_bytes(max_slots);
+    capacity_bounds_ready = true;
+}
+
+void llama_moe_stream::set_slot_count(uint32_t slots) {
+    n_slots = slots;
+    for (auto & layer : layers) {
+        if (!layer) {
+            continue;
+        }
+        layer->n_slots = slots;
+        layer->slot_expert.assign(slots, -1);
+        layer->slot_state.assign(slots, LLAMA_MOE_STREAM_SLOT_EMPTY);
+        layer->slot_claimed.assign(slots, 0);
+        layer->slot_gen.assign(slots, 0);
+        layer->slot_last_use.assign(slots, 0);
+        layer->expert_slot.clear();
+        layer->keep.assign(slots, 0);
+        layer->demand_slots.clear();
+        for (const auto & weight : layer->weights) {
+            weight.cache->ne[2] = slots;
+            weight.cache->nb[3] = weight.cache->nb[2] * slots;
+        }
+    }
+}
+
+void llama_moe_stream::clear_cache_buffers() {
+    bufs.clear();
+    for (const auto & layer : layers) {
+        if (!layer) {
+            continue;
+        }
+        for (const auto & weight : layer->weights) {
+            weight.cache->buffer = nullptr;
+            weight.cache->data = nullptr;
+        }
+    }
+}
+
+uint32_t llama_moe_stream::resolve_capacity_slots(uint64_t capacity_bytes) {
+    configure_capacity_bounds();
+    if (capacity_bytes < min_capacity_bytes) {
+        throw std::runtime_error("requested expert cache is below its startup minimum");
+    }
+    if (capacity_bytes >= max_capacity_bytes) {
+        return max_slots;
+    }
+    uint32_t low = min_slots;
+    uint32_t high = max_slots;
+    while (low < high) {
+        const uint32_t mid = low + (high - low + 1) / 2;
+        if (planned_capacity_bytes(mid) <= capacity_bytes) {
+            low = mid;
+        } else {
+            high = mid - 1;
+        }
+    }
+    return low;
+}
+
+void llama_moe_stream::resize_cache(uint64_t capacity_bytes) {
+    std::unique_lock<std::mutex> lock(mtx);
+    configure_capacity_bounds();
+    if (load_failed || shutting_down) {
+        throw std::runtime_error("expert cache is unavailable");
+    }
+    uint32_t target_slots = resolve_capacity_slots(capacity_bytes);
+    const auto settled = [&]() {
+        if (!q_demand.empty()) {
+            return false;
+        }
+        for (const auto & layer : layers) {
+            if (!layer) {
+                continue;
+            }
+            for (size_t slot = 0; slot < layer->slot_state.size(); ++slot) {
+                if (layer->slot_state[slot] == LLAMA_MOE_STREAM_SLOT_LOADING || layer->slot_claimed[slot]) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    };
+    cv_done.wait(lock, settled);
+    const uint32_t old_slots = n_slots;
+    // A resize replaces the contiguous backing; retain the MRU residents and reload them afterward.
+    using resident_state = std::vector<std::vector<std::pair<int32_t, int64_t>>>;
+    const auto snapshot_residents = [this](uint32_t slot_limit) {
+        resident_state residents(layers.size());
+        for (size_t index = 0; index < layers.size(); ++index) {
+            const auto & layer = layers[index];
+            if (!layer) {
+                continue;
+            }
+            auto & entries = residents[index];
+            for (uint32_t slot = 0; slot < layer->n_slots; ++slot) {
+                if (layer->slot_state[slot] == LLAMA_MOE_STREAM_SLOT_RESIDENT &&
+                    layer->slot_expert[slot] >= 0) {
+                    entries.emplace_back(layer->slot_expert[slot], layer->slot_last_use[slot]);
+                }
+            }
+            std::sort(entries.begin(), entries.end(), [](const auto & lhs, const auto & rhs) {
+                return lhs.second != rhs.second ? lhs.second > rhs.second : lhs.first < rhs.first;
+            });
+            if (entries.size() > slot_limit) {
+                entries.resize(slot_limit);
+            }
+        }
+        return residents;
+    };
+    const resident_state previous_residents = snapshot_residents(old_slots);
+    const auto residents_for_slots = [&previous_residents](uint32_t slots) {
+        resident_state retained = previous_residents;
+        for (auto & entries : retained) {
+            if (entries.size() > slots) {
+                entries.resize(slots);
+            }
