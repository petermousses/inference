+        synchronize();
+        stream->resize_cache(capacity_bytes);
+        stream->get_info(*info);
+        if (info->slots_per_layer == before.slots_per_layer) {
+            return !info->load_failed;
+        }
+        try {
+            sched_need_reserve = true;
+            sched_reserve();
+        } catch (...) {
+            const std::exception_ptr reserve_error = std::current_exception();
+            try {
+                stream->resize_cache(before.cache_bytes);
+                sched_need_reserve = true;
+                sched_reserve();
+            } catch (const std::exception & rollback_error) {
+                stream->quarantine();
+                LLAMA_LOG_ERROR("%s: expert-cache rollback failed: %s\n", __func__, rollback_error.what());
