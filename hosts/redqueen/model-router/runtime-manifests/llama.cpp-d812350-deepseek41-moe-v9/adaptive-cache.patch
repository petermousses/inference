+        }
+        cv_work.notify_all();
+        const auto restore_settled = [this]() {
+            if (!q_demand.empty()) {
+                return false;
+            }
+            bool loading = false;
+            for (const auto & layer : layers) {
+                if (!layer) {
+                    continue;
+                }
+                for (size_t slot = 0; slot < layer->slot_state.size(); ++slot) {
+                    if (layer->slot_claimed[slot]) {
+                        return false;
+                    }
+                    loading = loading || layer->slot_state[slot] == LLAMA_MOE_STREAM_SLOT_LOADING;
+                }
+            }
+            return load_failed || !loading;
+        };
