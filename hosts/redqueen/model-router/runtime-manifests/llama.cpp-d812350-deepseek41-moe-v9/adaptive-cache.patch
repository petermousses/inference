+            }
+            return static_cast<uint64_t>(total - overhead);
+        };
+        while (true) {
+            // Allocator rounding must not exceed the reservation sent by the scheduler.
+            if (target_slots != n_slots) {
+                clear_cache_buffers();
+                set_slot_count(target_slots);
+                const uint64_t old_budget = cache_budget;
+                cache_budget = max_cache_budget;
+                try {
+                    alloc_bufs(false);
+                } catch (...) {
+                    cache_budget = old_budget;
+                    throw;
+                }
+                cache_budget = old_budget;
+            }
+            if (allocated_capacity_bytes() <= capacity_bytes) {
+                break;
+            }
+            if (target_slots == min_slots) {
+                throw std::runtime_error("minimum expert cache allocation exceeds the requested capacity");
+            }
+            target_slots--;
+        }
+        if (n_slots != old_slots) {
+            restore_residents(residents_for_slots(target_slots));
+        }
+    } catch (...) {
+        const std::exception_ptr resize_error = std::current_exception();
+        try {
+            load_failed = true;
+            cv_work.notify_all();
+            cv_done.wait(lock, [this]() {
+                if (!q_demand.empty()) {
+                    return false;
+                }
+                for (const auto & layer : layers) {
+                    if (!layer) {
+                        continue;
+                    }
+                    for (const auto claimed : layer->slot_claimed) {
+                        if (claimed) {
+                            return false;
+                        }
+                    }
+                }
+                return true;
+            });
+            clear_cache_buffers();
+            set_slot_count(old_slots);
+            load_failed = false;
+            const uint64_t old_budget = cache_budget;
+            cache_budget = max_cache_budget;
+            try {
+                alloc_bufs(false);
+            } catch (...) {
+                cache_budget = old_budget;
+                throw;
+            }
+            cache_budget = old_budget;
+            restore_residents(previous_residents);
+        } catch (...) {
+            cache_budget = max_cache_budget;
+            load_failed = true;
+            throw std::runtime_error("expert-cache resize failed and prior backing could not be restored");
+        }
+        std::rethrow_exception(resize_error);
+    }
+    cv_done.notify_all();
+}
+void llama_moe_stream::quarantine() {
+    std::lock_guard<std::mutex> lock(mtx);
+    load_failed = true;
+    cv_done.notify_all();
+}
