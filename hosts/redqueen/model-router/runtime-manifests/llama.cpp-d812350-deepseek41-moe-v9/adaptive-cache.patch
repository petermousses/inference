+                stream->quarantine();
+                LLAMA_LOG_ERROR("%s: expert-cache rollback failed with an unknown error\n", __func__);
+            }
+            std::rethrow_exception(reserve_error);
+        }
+        stream->get_info(*info);
+        return !info->load_failed;
+    } catch (const std::exception & error) {
+        LLAMA_LOG_ERROR("%s: expert-cache resize failed: %s\n", __func__, error.what());
+        return false;
+    }
