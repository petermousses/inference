+        }
+        for (size_t index = 0; index < layers.size(); ++index) {
+            auto & layer = layers[index];
+            if (!layer) {
+                continue;
+            }
+            const size_t count = std::min<size_t>(n_slots, residents[index].size());
+            for (size_t slot = 0; slot < count; ++slot) {
+                const auto [expert, last_use] = residents[index][slot];
+                if (expert < 0 || static_cast<uint32_t>(expert) >= layer->n_expert ||
+                    layer->expert_slot.find(expert) != layer->expert_slot.end()) {
+                    throw std::runtime_error("expert-cache residency snapshot contains an invalid expert");
+                }
+                layer->slot_expert[slot] = expert;
+                layer->slot_state[slot] = LLAMA_MOE_STREAM_SLOT_LOADING;
+                layer->slot_claimed[slot] = 0;
+                layer->slot_gen[slot]++;
+                layer->slot_last_use[slot] = last_use;
+                layer->expert_slot.emplace(expert, static_cast<int32_t>(slot));
+                layer->seen[expert] = 1;
+                q_demand.push_back({layer.get(), expert, static_cast<int32_t>(slot), layer->slot_gen[slot]});
