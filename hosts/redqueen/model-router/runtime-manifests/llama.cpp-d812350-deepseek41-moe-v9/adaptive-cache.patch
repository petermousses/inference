+        const auto allocated_capacity_bytes = [this]() {
+            size_t total = 0;
+            for (const auto & [buft, size] : memory_breakdown()) {
+                GGML_UNUSED(buft);
+                if (size > SIZE_MAX - total) {
+                    throw std::runtime_error("expert cache allocation size overflows");
+                }
+                total += size;
+            }
+            const uint64_t overhead = host_overhead_bytes();
+            if (overhead > total) {
