+}
+
+struct resize_progress_state {
+    bool saw_allocation = false;
+    uint32_t current_slots = 0;
+    uint32_t target_slots = 0;
+};
+
+static void record_resize_progress(void * user_data, const char * phase,
+        uint32_t current_slots, uint32_t target_slots,
+        uint32_t, uint32_t, uint32_t, uint32_t) {
+    auto * state = static_cast<resize_progress_state *>(user_data);
+    if (std::string(phase) == "allocating_backing") {
+        state->saw_allocation = true;
+        state->current_slots = current_slots;
+        state->target_slots = target_slots;
+    }
 }
 
