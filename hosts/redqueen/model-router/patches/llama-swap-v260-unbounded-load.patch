diff --git a/internal/config/redqueen_unbounded_test.go b/internal/config/redqueen_unbounded_test.go
new file mode 100644
index 0000000..3e87604
--- /dev/null
+++ b/internal/config/redqueen_unbounded_test.go
@@ -0,0 +1,16 @@
+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRedqueenZeroHealthTimeoutSurvivesParsing(t *testing.T) {
+	cfg, err := LoadConfigFromReader(strings.NewReader("healthCheckTimeout: 0\nmodels:\n  a:\n    cmd: server --port ${PORT}\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.HealthCheckTimeout != 0 {
+		t.Fatalf("zero loading deadline became %d seconds", cfg.HealthCheckTimeout)
+	}
+}
diff --git a/internal/process/redqueen_unbounded_test.go b/internal/process/redqueen_unbounded_test.go
new file mode 100644
index 0000000..0299f72
--- /dev/null
+++ b/internal/process/redqueen_unbounded_test.go
@@ -0,0 +1,57 @@
+package process
+
+import (
+	"context"
+	"fmt"
+	"github.com/mostlygeek/llama-swap/internal/config"
+	"net/http"
+	"net/http/httptest"
+	"runtime"
+	"testing"
+	"time"
+)
+
+// Zero explicitly disables the loading deadline; each health HTTP probe is
+// still bounded and Stop/shutdown must still cancel an unready process.
+func TestRedqueenZeroLoadTimeoutWaitsForHealth(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("fixture uses POSIX sleep")
+	}
+	firstProbe := make(chan struct{}, 1)
+	ready := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case firstProbe <- struct{}{}:
+		default:
+		}
+		select {
+		case <-ready:
+			w.WriteHeader(http.StatusOK)
+		default:
+			w.WriteHeader(http.StatusServiceUnavailable)
+		}
+	}))
+	defer server.Close()
+	p := newProcessCommand(t, config.ModelConfig{Cmd: "sleep 30", Proxy: server.URL, CheckEndpoint: "/health"})
+	defer p.Stop(time.Second)
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- p.EnsureReady(ctx, 0) }()
+	select {
+	case err := <-done:
+		t.Fatalf("zero load timeout aborted before first health probe: %v", err)
+	case <-firstProbe:
+	case <-ctx.Done():
+		t.Fatal("health probe was never attempted")
+	}
+	close(ready)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(fmt.Errorf("healthy loading failed: %w", err))
+		}
+	case <-ctx.Done():
+		t.Fatal("loading did not become ready")
+	}
+}
