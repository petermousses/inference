[Unit]
Description=Qwen3.8-27B llama.cpp backend
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/ai/models/qwen3.8-27b/Qwen3.8-27B-Q4_K_M.gguf
ConditionPathExists=/srv/ai/models/qwen3.8-27b/mmproj-Qwen3.8-27B-Q8_0.gguf
ConditionPathExists=/srv/ai/secrets/qwen38-api-keys
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
Slice=ai-inference.slice
WorkingDirectory=/srv/ai
ExecStart=/usr/bin/llama-server --model /srv/ai/models/qwen3.8-27b/Qwen3.8-27B-Q4_K_M.gguf --mmproj /srv/ai/models/qwen3.8-27b/mmproj-Qwen3.8-27B-Q8_0.gguf --alias qwen3.8-27b --ctx-size 65536 --gpu-layers 999 --parallel 1 --cont-batching --flash-attn auto --jinja --metrics --slots --no-ui --threads 28 --threads-http 8 --api-key-file /srv/ai/secrets/qwen38-api-keys --host 10.9.20.242 --port 8081
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=60
KillSignal=SIGINT
KillMode=mixed
OOMPolicy=stop

CPUQuota=2800%
MemoryHigh=64G
MemoryMax=80G
TasksMax=4096
LimitNOFILE=1048576
UMask=0027

NoNewPrivileges=true
KeyringMode=private
LockPersonality=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/models/qwen3.8-27b
ReadOnlyPaths=/srv/ai/secrets/qwen38-api-keys
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
