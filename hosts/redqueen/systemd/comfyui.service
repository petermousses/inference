[Unit]
Description=ComfyUI Qwen Image 2.1 backend
Wants=network-online.target
After=network-online.target
ConditionPathIsDirectory=/srv/ai/comfyui/source
ConditionPathIsDirectory=/srv/ai/comfyui/venv
ConditionPathExists=/srv/ai/comfyui/extra-model-paths.yaml
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Slice=ai-inference.slice
WorkingDirectory=/srv/ai/comfyui/source
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=/srv/ai/cache/huggingface
Environment=TORCH_HOME=/srv/ai/cache/torch
Environment=XDG_CACHE_HOME=/srv/ai/cache
ExecStartPre=/usr/bin/mkdir -p /srv/ai/comfyui/state/custom_nodes /srv/ai/comfyui/state/input /srv/ai/comfyui/state/models /srv/ai/comfyui/state/output /srv/ai/comfyui/state/temp /srv/ai/comfyui/state/user/default/workflows
ExecStart=/srv/ai/comfyui/venv/bin/python /srv/ai/comfyui/source/main.py --listen 127.0.0.1 --port 8189 --disable-auto-launch --base-directory /srv/ai/comfyui/state --extra-model-paths-config /srv/ai/comfyui/extra-model-paths.yaml
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=mixed
OOMPolicy=stop

CPUQuota=2800%
MemoryHigh=88G
MemoryMax=96G
TasksMax=4096
LimitNOFILE=1048576
UMask=0027

NoNewPrivileges=true
KeyringMode=private
LockPersonality=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/comfyui/source
ReadOnlyPaths=/srv/ai/models/qwen-image-2.1
ReadOnlyPaths=/srv/ai/models/qwen-image-2.1-uncensored
ReadWritePaths=/srv/ai/comfyui/state
ReadWritePaths=/srv/ai/cache
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
