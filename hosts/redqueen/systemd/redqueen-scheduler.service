[Unit]
Description=Memory admission and idle-only LRU scheduling for Redqueen inference
Wants=redqueen-preflight.service network-online.target llama-swap.service
After=redqueen-preflight.service network-online.target llama-swap.service
ConditionPathExists=/srv/ai/model-router/run/memory-profiles.json
ConditionPathExists=/srv/ai/model-router/scheduler.json
ConditionPathIsDirectory=/srv/ai/model-router/venv
StartLimitIntervalSec=0

[Service]
Type=simple
Slice=ai-inference.slice
WorkingDirectory=/srv/ai/model-router
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/srv/ai/adapters/source
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
EnvironmentFile=/srv/ai/secrets/llama-swap.env
ExecStart=/srv/ai/model-router/venv/bin/python -m redqueen_adapters.scheduler_api
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStopSec=45
KillSignal=SIGINT
KillMode=mixed
CPUQuota=200%
MemoryHigh=512M
MemoryMax=1G
TasksMax=128
LimitNOFILE=8192
UMask=0077

NoNewPrivileges=true
KeyringMode=private
LockPersonality=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
# systemctl --user needs the bus under /run/user; true hides that directory.
ProtectHome=read-only
InaccessiblePaths=/home/ai
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/adapters
ReadOnlyPaths=/srv/ai/model-router
ReadOnlyPaths=/srv/ai/models
ReadOnlyPaths=/srv/ai/secrets/llama-swap.env
ReadWritePaths=/srv/ai/model-router/run
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
