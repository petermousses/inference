[Unit]
Description=DeepSeek-V4.1-Flash-1017 native HIP inference worker
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/ai/models/deepseek-v4.1-flash-1017/inference/config.json
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
Slice=ai-inference.slice
WorkingDirectory=/srv/ai/inference/hosts/redqueen/deepseek-hip/python
RuntimeDirectory=deepseek-hip
RuntimeDirectoryMode=0700
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/srv/ai/adapters/source
Environment=XDG_RUNTIME_DIR=%t
Environment=DS4_SCHEDULER_POLICY=/srv/ai/model-router/scheduler.json
Environment=DS4_REQUEST_PEAK_MIB=36864
Environment=DS4_HIP_FP8_GEMM_IMPL=exact
Environment=BUILD_DIR=%t/deepseek-hip
Environment=DS4_HIP_LIBRARY=%t/deepseek-hip/libredqueen_ds4_hip.so
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
EnvironmentFile=/srv/ai/secrets/llama-swap.env
ExecStartPre=/usr/bin/bash /srv/ai/inference/hosts/redqueen/deepseek-hip/build.sh
ExecStart=/srv/ai/comfyui/venv/bin/python /srv/ai/inference/hosts/redqueen/deepseek-hip/python/deepseek_server.py
Restart=no
RestartSec=5
TimeoutStartSec=1200
TimeoutStopSec=180
KillSignal=SIGINT
KillMode=mixed
OOMPolicy=stop

CPUQuota=2400%
MemoryHigh=96G
MemoryMax=112G
TasksMax=4096
LimitNOFILE=1048576
UMask=0027

NoNewPrivileges=true
KeyringMode=private
LockPersonality=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
InaccessiblePaths=/home/ai
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/adapters
ReadOnlyPaths=/srv/ai/inference
ReadOnlyPaths=/srv/ai/models/deepseek-v4.1-flash-1017
ReadOnlyPaths=/srv/ai/secrets/llama-swap.env
ReadWritePaths=%t/deepseek-hip
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
