[Unit]
Description=OpenAI-compatible dynamic text model router for redqueen
Wants=network-online.target
After=network-online.target
Requires=comfyui-control.service
After=comfyui-control.service
ConditionPathExists=/srv/ai/bin/llama-swap
ConditionPathExists=/usr/bin/llama-server
ConditionPathExists=/srv/ai/model-router/config.yaml
ConditionPathExists=/srv/ai/secrets/llama-swap.env
ConditionPathExists=/srv/ai/secrets/qwen38-api-keys
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
Slice=ai-inference.slice
WorkingDirectory=/srv/ai
EnvironmentFile=/srv/ai/secrets/llama-swap.env
ExecStart=/srv/ai/bin/llama-swap --config /srv/ai/model-router/config.yaml --listen 10.9.20.242:8081
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=120
KillSignal=SIGINT
KillMode=mixed
OOMPolicy=stop

CPUQuota=2800%
MemoryHigh=96G
MemoryMax=104G
TasksMax=4096
LimitNOFILE=1048576
UMask=0077

NoNewPrivileges=true
KeyringMode=private
LockPersonality=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/bin/llama-swap
ReadOnlyPaths=/usr/bin/llama-server
ReadOnlyPaths=/srv/ai/runtimes/llama.cpp-v0.6.0-d812350
ReadOnlyPaths=/srv/ai/runtimes/llama.cpp-b11457-5ad1c5d
ReadOnlyPaths=/srv/ai/model-router
ReadOnlyPaths=/srv/ai/models
ReadOnlyPaths=/srv/ai/secrets/llama-swap.env
ReadOnlyPaths=/srv/ai/secrets/qwen38-api-keys
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
