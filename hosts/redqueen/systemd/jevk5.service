[Unit]
Description=JevK5 4B v0.3 llama.cpp backend
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/ai/models/jevk5-4b-v0.3/jevk5-4b-v0.3-Q8_0.gguf
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Slice=ai-inference.slice
WorkingDirectory=/srv/ai
ExecStart=/usr/bin/llama-server --model /srv/ai/models/jevk5-4b-v0.3/jevk5-4b-v0.3-Q8_0.gguf --alias jevk5-4b-v0.3 --ctx-size 32768 --gpu-layers 999 --parallel 4 --cont-batching --flash-attn auto --jinja --metrics --slots --no-ui --threads 16 --threads-http 8 --host 127.0.0.1 --port 8082
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=mixed
OOMPolicy=stop

CPUQuota=1600%
MemoryHigh=16G
MemoryMax=24G
TasksMax=2048
LimitNOFILE=1048576
UMask=0027

NoNewPrivileges=true
KeyringMode=private
LockPersonality=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/models/jevk5-4b-v0.3
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
