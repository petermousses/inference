[Unit]
Description=Qwen3-8B last-token embedding encoder for CLM
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/ai/models/clm-v0.1-8b/Qwen3-8B-f16.gguf
ConditionPathExists=/srv/ai/runtimes/llama.cpp-b11457-5ad1c5d/bin/llama-server
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Slice=ai-inference.slice
WorkingDirectory=/srv/ai
ExecStart=/srv/ai/runtimes/llama.cpp-b11457-5ad1c5d/bin/llama-server --model /srv/ai/models/clm-v0.1-8b/Qwen3-8B-f16.gguf --alias qwen3-8b --ctx-size 2048 --pooling last --embedding --gpu-layers 999 --parallel 1 --cont-batching --flash-attn auto --metrics --slots --no-ui --threads 16 --threads-http 8 --host 127.0.0.1 --port 8090
Restart=no
RestartSec=5
TimeoutStartSec=600
TimeoutStopSec=30
KillSignal=SIGINT
KillMode=mixed
OOMPolicy=stop

CPUQuota=1600%
MemoryHigh=28G
MemoryMax=36G
TasksMax=2048
LimitNOFILE=1048576
UMask=0027

NoNewPrivileges=true
KeyringMode=private
LockPersonality=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/models/clm-v0.1-8b
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
